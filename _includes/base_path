{% comment %}
  Production: absolute site.url + baseurl (canonical, OG, deploy).
  Local serve (JEKYLL_ENV=development, the default for `jekyll serve`) and
  docker: root-relative baseurl so CSS/JS load from localhost, not godsped.com.
{% endcomment %}
{% if jekyll.environment == "production" and site.url %}
  {% assign base_path = site.url | append: site.baseurl %}
{% else %}
  {% assign base_path = site.baseurl %}
{% endif %}
